# Valores FICTÍCIOS para build e testes de ponta a ponta (sem segredos).
# Turnstile: chaves públicas de teste da Cloudflare (sempre aprovam).
NEXT_PUBLIC_SUPABASE_URL=https://exemplo-teste.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_teste_0000000000000000
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# A chave secreta de teste responde com hostname "example.com".
TURNSTILE_EXPECTED_HOSTNAME=example.com
