{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iron-ai-escuta",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Transcrição em tempo real (Deepgram Nova-3) roda no Workers AI.
  "ai": { "binding": "AI" },
  // Página de teste (escuta/teste). O Worker roda antes dos arquivos e só os
  // entrega no modo de teste; sem isso, a pasta ficaria pública.
  "assets": { "directory": "./teste", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "REUNIAO", "class_name": "ReuniaoEscuta" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReuniaoEscuta"] }],
  "vars": {
    // Origens que podem abrir a escuta, separadas por vírgula. Nunca curinga.
    // App em produção, o preview da branch da tela (remover depois do merge) e a página de teste local.
    "ORIGENS_PERMITIDAS": "https://app.iron-ai.io,https://iron-ai-app-git-claude-self-escuta-tela-iron-security.vercel.app,http://localhost:8788"
  }
  // Segredos (nunca aqui), cadastrados no painel ou com `wrangler secret put`:
  // - ESCUTA_TOKEN_SECRET: assina o token curto (32+ caracteres);
  // - TESTE_CODIGO: liga a página de teste (16+ caracteres). Apagar desliga.
}
