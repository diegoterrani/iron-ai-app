# Copie para .env.local. Nunca versione valores reais.
# Lista completa e onde pegar cada valor: docs/setup-supabase.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chaves de TESTE da Cloudflare (sempre aprovam) para desenvolvimento:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# A chave secreta de teste responde com hostname "example.com".
TURNSTILE_EXPECTED_HOSTNAME=example.com
# Só servidor (Sensitive na Vercel). Usada apenas para enviar convites.
SUPABASE_SECRET_KEY=
